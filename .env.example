# Copie este arquivo para .env e preencha com as chaves reais.
# .env esta gitignored — nunca comite.
#
# Onde obter (detalhe nas skills n8n-projeto e torre-projeto):
#  - N8N_*_KEY: na instancia n8n -> Settings -> n8n API -> Create an API key (uma por ambiente).
#               Referencia adicional do time no Confluence (ver N8N-AGENT/README.md).
#  - GRAFANA_SERVICE_ACCOUNT_TOKEN: blipsdata.grafana.net -> Administration -> Service accounts.
#  - SUPABASE project_ref: Supabase Dashboard, ou reaproveite de cobranca-finza/.env.local
#                          e src/integrations/supabase/client.ts.

# ─── n8n (read-only) ───
# Ambiente de desenvolvimento
N8N_DEV_URL=https://n8n-dev.blips-labs.com
N8N_DEV_KEY=

# Producao — Assistentes
N8N_PROD_ASSISTANTS_URL=https://n8n-assistants.blips-labs.com
N8N_PROD_ASSISTANTS_KEY=

# Producao — Auditoria
N8N_PROD_AUDITORIA_URL=https://n8n-auditoria.blips-labs.com
N8N_PROD_AUDITORIA_KEY=

# Producao — SalesOps
N8N_PROD_SALESOPS_URL=https://salesops.blips-labs.com
N8N_PROD_SALESOPS_KEY=

# Producao — Automacao
N8N_PROD_AUTOMACAO_URL=https://automacao.blips-labs.com
N8N_PROD_AUTOMACAO_KEY=

# Producao — Monitoria
N8N_PROD_MONITORIA_URL=https://monitoria.blips-labs.com
N8N_PROD_MONITORIA_KEY=

# ─── Grafana (metricas n8n) ───
GRAFANA_URL=https://blipsdata.grafana.net/
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# ─── Supabase (Torre — read-only) ───
SUPABASE_PROJECT_REF_PROD=
SUPABASE_PROJECT_REF_DEV=
